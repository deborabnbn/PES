bairros = ["palhocinha"]

indice = 0

while indice < 5:
    bairro = input("digite o nome do bairro: ")
    bairros.append(bairro)
    indice = indice + 1 

indice = 0 
while indice < len(bairros):
    print (bairros[indice])
